@model RestaurantMenuApp.Models.MenuItem
@{
    ViewData["Title"] = "Menü Düzenle";
}

<h2>Menü Düzenle</h2>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        <ul>
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li>@error.ErrorMessage</li>
            }
        </ul>
    </div>
}

<form method="post" enctype="multipart/form-data">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="RestaurantId" />

    <div class="mb-3">
        <label>Menü Başlığı</label>
        <input asp-for="Title" class="form-control" required />
    </div>

    <div class="mb-3">
        <label>Fiyat (₺)</label>
        <input asp-for="Price" class="form-control" type="number" step="0.01" required />
    </div>

    <div class="mb-3">
        <label>Kategori</label>
        <select asp-for="CategoryId" class="form-control" required>
            <option value="">Kategori Seçin</option>
            @foreach (var cat in ViewBag.Categories as List<RestaurantMenuApp.Models.Category>)
            {
                if (Model != null && Model.CategoryId == cat.Id)
                {
                    <option value="@cat.Id" selected>@cat.Name</option>
                }
                else
                {
                    <option value="@cat.Id">@cat.Name</option>
                }
            }
        </select>
    </div>

    <div class="mb-3">
        <label>Resim</label>
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <div class="mb-2">
                <img src="@Model.ImageUrl" style="height:150px; object-fit:cover;" />
            </div>
        }
        <input type="file" name="imageFile" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Kaydet</button>
    <a href="/Menu/Index" class="btn btn-secondary">İptal</a>
</form>
