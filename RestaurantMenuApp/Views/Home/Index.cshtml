@{
    ViewData["Title"] = "Hoşgeldiniz - Restoran Menü Uygulaması";
}

<div class="container-fluid p-0">
    <!-- Hero Section -->
    <div class="bg-dark text-white text-center d-flex flex-column justify-content-center align-items-center" style="height: 80vh; background: url('/images/hero-bg.jpg') center/cover no-repeat;">
        <h1 class="display-3 fw-bold">Restoran Menünüzü Ücretsiz Yayınlayın</h1>
        <p class="lead mt-3">Dakikalar içinde kendi menünüzü oluşturun, müşterileriniz kolayca erişsin.</p>
        <a href="/Menu/Create" class="btn btn-primary btn-lg mt-4">Hemen Başlayın</a>
    </div>

    <!-- Features Section -->
    <div class="container py-5">
        <div class="row text-center">
            <div class="col-md-4">
                <img src="/images/free.png" alt="Ücretsiz" class="mb-3" style="height:80px;">
                <h3>Ücretsiz</h3>
                <p>Restoranınızı kaydedin, menülerinizi ekleyin. Tümü ücretsiz!</p>
            </div>
            <div class="col-md-4">
                <img src="/images/easy.png" alt="Kolay Kullanım" class="mb-3" style="height:80px;">
                <h3>Kolay Kullanım</h3>
                <p>Basit ve anlaşılır arayüz ile dakikalar içinde menünüz hazır.</p>
            </div>
            <div class="col-md-4">
                <img src="/images/mobile.png" alt="Mobil Uyumlu" class="mb-3" style="height:80px;">
                <h3>Mobil Uyumlu</h3>
                <p>Müşterileriniz menünüze telefondan veya bilgisayardan kolayca erişir.</p>
            </div>
        </div>
    </div>

    <!-- Call To Action -->
    <div class="bg-light text-center py-5">
        <h2>Menünüzü hemen yükleyin!</h2>
        <p class="mb-4">Kayıt olun, kategorilerinizi oluşturun ve menülerinizi ekleyin.</p>
        <a href="/Account/Login" class="btn btn-success btn-lg">Giriş Yap / Kayıt Ol</a>
    </div>
</div>
